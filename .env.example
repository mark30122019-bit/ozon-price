# Скопируйте этот файл в .env и подставьте свои значения:
#   copy .env.example .env

OZON_CLIENT_ID=ваш_client_id
OZON_API_KEY=ваш_api_key

# Желаемая минимальная цена для покупателя с Ozon Картой (руб.)
TARGET_MARKET_PRICE=1500

# Наценка к текущей цене на сайте при пересчёте (проценты)
SITE_PRICE_MARKUP_PERCENT=5

# Только расчёт цен без отправки в Ozon (удобно для первой проверки)
# DRY_RUN=1
