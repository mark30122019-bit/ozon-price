# Скопируйте этот файл в .env и подставьте свои значения:
#   copy .env.example .env

OZON_CLIENT_ID=ваш_client_id
OZON_API_KEY=ваш_api_key

# Firebase: JSON сервисного аккаунта (строка) или путь к файлу для локальной разработки
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
FIREBASE_CREDENTIALS_FILE=./firebase-service-account.json

# Только расчёт цен без отправки в Ozon (удобно для первой проверки)
# DRY_RUN=1
